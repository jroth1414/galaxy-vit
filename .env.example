# Galaxy-ViT environment variables (required).
#
# `galaxy_vit.config.Settings` (Pydantic BaseSettings) loads these on startup
# and FAILS LOUDLY if any are missing. Copy this file to `.env` and fill in.
# Never commit `.env`. `detect-secrets` pre-commit hook backs this up.
#
# Experiment tracking is local-only (TensorBoard + matplotlib PNG artefacts
# committed alongside each run); no external account or API key required.

# Hugging Face Hub — model + Space deployment
HF_USER=
HF_TOKEN=

# Local data cache (must be a writable directory OUTSIDE the repo tree, to
# keep ~1-2 GB of dataset shards from contaminating the source tree).
# Linux/Mac convention: ~/.cache/galaxy_vit
# Windows convention:   C:\Users\<you>\.cache\galaxy_vit  (or similar)
DATA_DIR=
