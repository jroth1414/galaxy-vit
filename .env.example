# Galaxy-ViT environment variables (required).
#
# `galaxy_vit.config.Settings` (Pydantic BaseSettings) loads these on startup
# and FAILS LOUDLY if any are missing. Copy this file to `.env` and fill in.
# Never commit `.env`. `detect-secrets` pre-commit hook backs this up.

# Hugging Face Hub — model + Space deployment
HF_USER=
HF_TOKEN=

# Weights & Biases — training run tracking
WANDB_API_KEY=
WANDB_ENTITY=

# Local data cache (e.g. ~/.cache/galaxy_vit on Linux/Mac,
#                  C:\Users\<you>\.cache\galaxy_vit on Windows)
DATA_DIR=
