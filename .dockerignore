# Keep the build context small.
.git/
.github/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
__pycache__/
*.pyc
*.pyo
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Frontend build artefacts (rebuilt inside the image)
frontend/node_modules/
frontend/dist/

# Per-run / experiment-tracking dirs that don't belong in the image.
# Model checkpoints (runs/**/best.pt) are downloaded from HF Hub at
# runtime by the FastAPI lifespan; tb/ event files are useless inside
# the image. data/ and artifacts/ ARE needed inside the image and are
# intentionally NOT excluded -- they carry the canonical question
# schema (data/splits/) and the live-demo bundle (thumbnails, UMAP
# coords, sky points, saliencies, etc.; ~40 MB total).
runs/
releases/
wandb/
mlruns/
.cache/

# Trainer-time-only artifact (~3 MB); not used at runtime.
artifacts/per_epoch_demo_features.parquet

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets
.env
.env.*
!.env.example
.secrets.baseline.local

# Docs not needed in the runtime image
docs/
