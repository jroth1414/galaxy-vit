# Frontend (Vite/React, populated in T1.8)
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
*.log
npm-debug.log*

# Data & runs (large artifacts; tracked separately).
# Anchored with a leading slash so they only match top-level dirs and do NOT
# shadow the `galaxy_vit/data/` Python subpackage.
/data/
/runs/
/artifacts/
/releases/
/wandb/
/mlruns/
*.parquet
*.npy
*.npz
*.ckpt
*.pt
*.pth
*.onnx
*.safetensors

# Docker
.dockerignore.local

# HF cache (dev only; CI uses fresh cache)
/.cache/
~/.cache/galaxy_vit/

# Claude Code agent local state — never commit
.claude/

# Misc
*.bak
*.tmp
