# Frontend (Vite/React, populated in T1.8)
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
*.log
npm-debug.log*

# Data & runs (large artifacts; tracked separately).
# Anchored with a leading slash so they only match top-level dirs and do NOT
# shadow the `galaxy_vit/data/` Python subpackage.
# NOTE: /data/splits/ is exempted because README §Reproducibility Guarantees
# requires data/splits/*.csv to be committed alongside the code that produced
# them. The splits live next to a run_config.json sibling for traceability.
/data/*
!/data/splits/

# Training runs/<id>/ — ignore the heavy artefacts (model checkpoints,
# TensorBoard event files) but commit the small reproducibility files
# (metrics.json, curves.png, run_config.json) so the model card and any
# future cross-run analysis can rely on them being in-tree.
/runs/*
!/runs/*/
/runs/*/*
!/runs/*/metrics.json
!/runs/*/curves.png
!/runs/*/run_config.json

/artifacts/
/releases/
/wandb/
/mlruns/
*.parquet
*.npy
*.npz
*.ckpt
*.pt
*.pth
*.onnx
*.safetensors

# Docker
.dockerignore.local

# HF cache (dev only; CI uses fresh cache)
/.cache/
~/.cache/galaxy_vit/

# Claude Code agent local state — never commit
.claude/

# Misc
*.bak
*.tmp
