# Data & runs (large artifacts; tracked separately).
# Anchored with a leading slash so they only match top-level dirs and do NOT
# shadow the `galaxy_vit/data/` Python subpackage.
# NOTE: /data/splits/ is exempted because README §Reproducibility Guarantees
# requires data/splits/*.csv to be committed alongside the code that produced
# them. The splits live next to a run_config.json sibling for traceability.
# /data/shards/ is the WebDataset tar-shard cache — multi-GB, regenerable
# via `scripts/build_gz_desi_shards.py`, never tracked.
/data/*
!/data/splits/
/data/shards/

# Training runs/<id>/ — ignore the heavy artefacts (model checkpoints,
# TensorBoard event files) but commit the small reproducibility files
# (metrics.json, curves.png, run_config.json, interpretability overlays)
# so the model card and any future cross-run analysis can rely on them
# being in-tree.
/runs/*
!/runs/*/
/runs/*/*
!/runs/*/metrics.json
!/runs/*/calibrated_metrics.json
!/runs/*/inference_dry_run.json
!/runs/*/curves.png
!/runs/*/run_config.json
!/runs/*/interpretability/

# Static artefacts (UMAP plots, model card figures, etc). Same pattern as
# /runs/: ignore the heavy regenerable bits (parquet point clouds, numpy
# feature dumps) but commit the small reproducibility files (PNG figures
# and metric summaries) so model-card sections that reference them work
# in a fresh checkout.
/artifacts/*
!/artifacts/*.png
!/artifacts/*_metrics.json
# T4.3 demo-galaxies bundle: small JPEG thumbnails + manifest used by the
# Posteriors tab. ~24 x 4 KB JPEGs + a small JSON; safe to commit.
!/artifacts/demo_galaxies/
!/artifacts/demo_galaxies/manifest.json
!/artifacts/demo_galaxies/thumbs/
!/artifacts/demo_galaxies/thumbs/*.jpg
# T4.2 UMAP Explorer: per-test-galaxy thumbnails (2,462 x 4 KB = ~10 MB
# total) + the UMAP coords parquet (~30 KB). The parquet specifically
# overrides the global *.parquet ignore below.
!/artifacts/test_thumbs/
!/artifacts/test_thumbs/*.jpg
# S-4 precomputed GradCAM overlays (2,462 x ~5 KB JPEG = ~13 MB).
# Required by the Explorer tab's hover crossfade.
!/artifacts/test_saliencies/
!/artifacts/test_saliencies/*.jpg
!/artifacts/umap_coords.parquet
# S-3 outlier rankings: small JSON (~25 KB; top-100 per metric).
# Required at runtime by /api/outliers; safe to commit.
!/artifacts/outliers.json
# T5.1 release parquet + sidecar -- the canonical inference output.
# Small enough (~15 MB for the labeled subset) to commit; T5.3 also
# uploads to Zenodo for a citable DOI, but having it in git makes the
# T5.1 acceptance gates self-contained.
/releases/*
!/releases/*.parquet
!/releases/*.meta.json
/wandb/
/mlruns/
*.parquet
# Restore the artifact-specific parquet allowlist after the global rule.
!/artifacts/umap_coords.parquet
# S-1 similarity feature cache (~10 MB; 2,462 x 640 float32 vectors).
# Required at runtime by /api/similar; small enough to commit.
!/artifacts/test_thumb_features.parquet
# A-6 3-D UMAP coords (~50 KB; required by Explorer's 3-D toggle).
!/artifacts/umap_3d_coords.parquet
# Same for the T5.1 release parquet -- the global *.parquet would
# otherwise win over the /releases/ allowlist above.
!/releases/*.parquet
*.npy
*.npz
*.ckpt
*.pt
*.pth
*.onnx
*.safetensors

# Docker
.dockerignore.local

# HF cache (dev only; CI uses fresh cache)
/.cache/
~/.cache/galaxy_vit/

# Claude Code agent local state — never commit
.claude/

# Misc
*.bak
*.tmp

# Paper (T6.1): build outputs and the local Tectonic engine binary.
# Source files (.tex, .bib, figures/) are tracked; build artefacts are not.
/tools/
paper/main.pdf
paper/main.aux
paper/main.bbl
paper/main.blg
paper/main.log
paper/main.out
paper/main.xdv
paper/main.toc
